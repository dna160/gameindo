# ─────────────────────────────────────────────────────────────────────────────
# GameIndo newsroom — configuration template.
#
# Copy to `.env` at the repo root and fill in. Every key below is read by the
# code; nothing here is decorative. (An earlier config carried
# LLM_MAX_CONCURRENCY and LLM_CONTEXT_TOKENS, which the code never reads --
# they are LM Studio-side settings, not app settings.)
# ─────────────────────────────────────────────────────────────────────────────

# ── Local LLM (LM Studio / Ollama, OpenAI-compatible) ───────────────────────
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_API_KEY=lm-studio
# Must match the model id loaded in your LLM server exactly.
LLM_MODEL=google/gemma-4-e4b
# Local generation is slow; 10 minutes per call.
LLM_TIMEOUT_MS=600000
# Ceiling per call. NOTE: the correct key is _CAP.
LLM_MAX_TOKENS_CAP=8192
# Floor for the FIRST attempt. Too low and every call truncates, gets thrown
# away and is retried at double the budget -- one run logged 501 such retries
# and finished zero articles inside the 2h watchdog.
LLM_MIN_TOKENS=2048
# LLM_MAX_PER_MINUTE=2500

# ── Image search (optional) ─────────────────────────────────────────────────
# Without this the Researcher cannot source images; articles still get written.
SERPER_API_KEY=

# ── WordPress publishing ────────────────────────────────────────────────────
# Leave WP_BASE_URL blank to skip publishing (articles stay in the dashboard).
WP_BASE_URL=https://gameindo.com
WP_URL=https://gameindo.com
WP_USERNAME=
WP_APP_PASSWORD=

# ── Social (off: no outlets configured) ─────────────────────────────────────
SOCIAL_ENABLED=false

# ── Database ────────────────────────────────────────────────────────────────
# Create the database with: powershell ops\setup-db.ps1
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/gameindo"

# ── Server ──────────────────────────────────────────────────────────────────
# One process serves the dashboard (/) and the API (/api) on this port.
PORT=3000
# Baked into the dashboard bundle at BUILD time. Must be set: the code's
# fallback is a Railway URL, which would silently show another site's data.
VITE_API_URL=http://localhost:3000

# ── Pipeline ────────────────────────────────────────────────────────────────
# Don't fire a run on every restart; the cron still runs it.
PIPELINE_RUN_ON_STARTUP=false
# Local time. Explicit hours, not */8 -- a step is anchored to midnight.
PIPELINE_CRON_SCHEDULE="0 3,11,19 * * *"
# Hard ceiling on one run (default 2h).
# PIPELINE_MAX_RUN_MS=7200000

# ── Scout ───────────────────────────────────────────────────────────────────
# Require a Video Game platform claim to be corroborated by the source text.
# false trusts the model and lets more non-game items through.
# SCOUT_REQUIRE_PLATFORM_EVIDENCE=true
